# Copy to ~/aimarketing.secrets.env and fill values.
# Do NOT commit the filled file. Same key names as the app .env.

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://aimarketing:YOUR_PASSWORD@postgres:5432/aimarketing

AUTH_JWT_SECRET=
NEXTAUTH_SECRET=
SCHEDULER_SECRET=
TOKEN_ENCRYPTION_KEY=

OPENROUTER_API_KEY=
GOOGLE_API_KEY=

S3_ACCESS_KEY=
S3_SECRET_KEY=

GOOGLE_CLIENT_SECRET=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
